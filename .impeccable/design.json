      "css": ".ds-links{display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem 1.5rem;background:#101316}.ds-link{display:inline-flex;align-items:center;justify-content:space-between;min-height:44px;gap:0.75rem;color:#eef0f1;font-family:var(--font-geist-sans),sans-serif;font-size:0.8rem;text-decoration:underline;text-decoration-color:#383e43;text-underline-offset:6px;transition:color 160ms,text-decoration-color 160ms}.ds-link:hover{color:#b9c0c5;text-decoration-color:currentColor}.ds-link:focus-visible{outline:2px solid #eef0f1;outline-offset:6px}@media(max-width:1023px){.ds-links{justify-content:space-between}}@media(max-width:767px){.ds-link{font-size:0.75rem}}@media(prefers-reduced-motion:reduce){.ds-link{transition:none}}"
