  "narrative": {
    "northStar": "Precise studio / restrained industrial",
    "overview": "This record covers only the artist home heroes in app/components/hero.tsx and the hero appearance of AudioTrack. It captures the implemented precise studio character of F.A.T.E. and restrained industrial character of Buried In Ruin. It does not establish a replacement system for the header, catalog, song pages, default audio player, or other incumbent surfaces.\n\nReal artist marks, the existing F.A.T.E. portrait, and authoritative published release art carry the identity. Flat playback controls and an integrated listening rail provide functional precision; image crops and ground-colored fades supply depth. This record is extracted from source and does not assert visual review signoff.",
    "keyCharacteristics": [
      "Two local artist palettes with shared functional roles.",
      "Authentic imagery and recognizable artist marks.",
      "Flat rectangular controls, visible focus, and real timing."
    ],
    "rules": [
      {
        "name": "The Local Palette Rule",
        "body": "Apply these palette roles only inside the hero and its playback rail. Preserve incumbent artist theme tokens and other surfaces outside this scope.",
        "section": "colors"
      },
      {
        "name": "The Artist Mark Rule",
        "body": "Preserve the existing image logos as the artist identity; release titles remain live Geist text.",
        "section": "typography"
      },
      {
        "name": "The Flat Listening Rule",
        "body": "Hero playback uses the page ground, border rules, and solid action color without a separate glass card or glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the existing portrait, artist marks, and catalog-owned release art.",
      "Do keep these tokens local to the hero and hero playback appearance.",
      "Do retain visible focus, text playback states, and full-height touch targets.",
      "Do preserve live track titles, timing, preview offsets, and coordinated playback."
    ],
    "donts": [
      "Don't apply this scoped redesign to the rest of the site without a separate request.",
      "Don't add a floating glass or glow player wrapper to these heroes.",
      "Don't replace authoritative release art with generated artwork.",
      "Don't promote hero-specific composition or identity text into a universal page template."
    ]
  }
