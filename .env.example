# Required for both artist catalogs. Copy exact Artist catalog feed URLs from
# Evolve & Elevate -> song sharing -> Automatic artist sync.
# Use /api/music/public-catalog/<ownerId>/<artistId>, not a single-song URL.
# Missing/failed feeds show an unavailable catalog; no bundled songs are used.
MUSIC_CATALOG_FATE_URL=
MUSIC_CATALOG_BURIED_IN_RUIN_URL=

# Django handles interaction storage and email delivery independently of catalogs.
# Use the current deployed API origin in Vercel; localhost only works in local dev.
NEXT_PUBLIC_DJANGO_API_URL=
